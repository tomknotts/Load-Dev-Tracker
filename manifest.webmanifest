{
  "name": "Load Dev Tracker",
  "short_name": "Load Dev",
  "description": "Offline load-development tracker. All data stays on this device.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
